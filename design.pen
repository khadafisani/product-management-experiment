                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 10,
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 16,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "JW1mx",
                      "name": "Title",
                      "fill": "$ink",
                      "content": "How this forecast works",
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "ipk1f",
                      "name": "Description",
                      "fill": "$muted",
                      "content": "Daily demand = units sold in last 30 calendar days / 30. Coverage = stock / daily demand.",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fM6lc",
                      "name": "Formula",
                      "fill": "$muted",
                      "content": "Projected = stock − demand × horizon. Suggested = max(0, ceil(demand × (horizon + lead time) + reorder level − stock)).",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tJpAY",
                      "name": "Note",
                      "fill": "$muted",
                      "content": "Negative projection is unmet demand. Assumes steady demand; excludes open POs and seasonality.",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
